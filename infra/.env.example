# Copy to .env at the repo root (git ignores it). Set your id and use your own port block.
# Port blocks: java1 8100-8199, java2 8200-8299, ml1 8300-8399, ml2 8400-8499, ml3 8500-8599
ID=java1
COMPOSE_PROJECT_NAME=java1

PORT_POSTGRES=8101
PORT_REDIS=8102
PORT_MINIO=8103
PORT_MINIO_CONSOLE=8104
PORT_RABBIT=8105
PORT_RABBIT_UI=8106
PORT_OLLAMA=8107
PORT_MYSQL=8201
PORT_ELASTIC=8202

POSTGRES_PASSWORD=dev
MYSQL_ROOT_PASSWORD=dev
